# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Python files must use LF
*.py text eol=lf

# Shell scripts must use LF
*.sh text eol=lf

# YAML must use LF
*.yml text eol=lf
*.yaml text eol=lf

# Dockerfiles must use LF
Dockerfile text eol=lf
**/Dockerfile text eol=lf

# Makefiles must use LF
Makefile text eol=lf
