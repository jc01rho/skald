# Non-secret runtime settings. Credentials are supplied only through container
# environment variables; do not copy them into this file.
model:
  provider: skald-proxy
  default: your-openai-compatible-model
  base_url: https://your-openai-compatible-provider.example/v1
providers:
  skald-proxy:
    base_url: https://your-openai-compatible-provider.example/v1
    key_env: OPENAI_API_KEY
    model: your-openai-compatible-model
    api_mode: chat_completions
onboarding:
  profile_build: off

terminal:
  cwd: /var/lib/hermes

# Hermes native Discord policy is authoritative for this migration.
discord:
  require_mention: true
  allowed_channels: "*"
  auto_thread: true
  thread_require_mention: true
  history_backfill: true
  history_backfill_limit: 50
  reactions: true

platforms:
  discord:
    extra:
      slash_commands: false
# Functional-spec-only tool surface: exactly one unchanged MCP checkout/wrapper.
platform_toolsets:
  discord: []
agent:
  disabled_toolsets:
    - kanban

mcp_servers:
  sparrow-function-spec:
    url: https://mcp.skald.sparrow.local/mcp
    enabled: true
