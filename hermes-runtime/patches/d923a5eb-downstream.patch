+    def _self_role_id(self, message: Any) -> Optional[str]:
+        """ID of this bot's own managed integration role when the message mentions it, else None.
+        Users often pick the bot's role instead of the bot account from Discord's @ autocomplete."""
+        if not self._client or not self._client.user:
+            return None
+        guild = getattr(message, "guild", None)
+        if guild is None:
+            return None
+        bot_id = self._client.user.id
+        content = getattr(message, "content", "") or ""
+        raw_role_ids = {match.group(1) for match in re.finditer(r"<@&(\d+)>", content)}
+        self_role = getattr(guild, "self_role", None)
+        if self_role is not None and (self_role in getattr(message, "role_mentions", []) or str(self_role.id) in raw_role_ids):
+            return str(self_role.id)
+        candidates = list(getattr(message, "role_mentions", []))
+        get_role = getattr(guild, "get_role", None)
+        if get_role is not None:
+            candidates.extend(role for role in (get_role(int(role_id)) for role_id in raw_role_ids) if role is not None)
+        for role in candidates:
+            if getattr(getattr(role, "tags", None), "bot_id", None) == bot_id:
+                return str(role.id)
+        return None
+
