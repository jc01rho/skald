# Skald API Configuration
SKALD_BASE_URL=http://localhost:3000
SKALD_API_KEY=your-skald-api-key
SKALD_PROJECT_ID=your-project-id

# Jira Configuration
JIRA_SERVER=https://jira.example.com
JIRA_URL=https://jira.example.com
JIRA_USER=your-jira-username
JIRA_PASSWORD=your-jira-password-or-api-token
JIRA_JQL_FILTER=TYPE IN (인시던트, 장애) AND updated >= -1d ORDER BY updated DESC
JIRA_POLL_INTERVAL_MINUTES=10
JIRA_ENABLED=true

# Technical Docs Configuration
SPMS_BASE_URL=https://docs.example.com
SPMS_API_KEY=your-docs-api-key
DOCS_POLL_INTERVAL_MINUTES=30
DOCS_ENABLED=true

# Worker Configuration
WORKER_CONCURRENCY=4
LOG_LEVEL=INFO
LOG_FORMAT=console

# Server Configuration
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development

# Security Configuration
# Leave empty to disable API key authentication
WORKER_API_KEY=

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# Sync State Persistence
SYNC_STATE_FILE=/tmp/skald-worker-sync-state.json
