# Skald API Configuration
SKALD_BASE_URL=http://localhost:3000
SKALD_API_KEY=your-skald-api-key
SKALD_PROJECT_ID=your-project-id

# Jira Configuration
JIRA_SERVER=https://jira.example.com
JIRA_URL=https://jira.example.com
JIRA_USER=your-jira-username
JIRA_PASSWORD=your-jira-password-or-api-token
JIRA_JQL_FILTER=TYPE IN (인시던트, 장애) AND updated >= -1d ORDER BY updated DESC
JIRA_POLL_INTERVAL_MINUTES=10
JIRA_ENABLED=false

# SPMS-backed Collector Configuration
SPMS_BASE_URL=https://docs.example.com
# Optional for local development. In production this belongs in a Secret, never a ConfigMap.
SPMS_API_KEY=
# Safe default: require SPMS authentication in production when docs collection is enabled.
# Set false only for an internal SPMS endpoint that intentionally accepts unauthenticated requests.
SPMS_AUTH_REQUIRED=true
DOCS_POLL_INTERVAL_MINUTES=30
DOCS_SYNC_CRON_HOUR=3
DOCS_SYNC_CRON_MINUTE=0
DOCS_SYNC_DAYS=7
DOCS_ENABLED=false
RELEASE_ENABLED=false
USERDATA_ENABLED=false

# Spec reconciliation and startup operations
# Reconciliation runs at this relative scheduler cadence while docs and SPMS are enabled.
DOCS_RECONCILIATION_INTERVAL_HOURS=24
# Retained compatibility setting for existing deployments.
DOCS_RECONCILIATION_GRACE_HOURS=48
# All authoritative runs, including scheduled runs, use these evidence windows.
SPEC_RECONCILIATION_INTERVAL_SECONDS=86400
SPEC_RECONCILIATION_GRACE_SECONDS=172800
# Startup operations are opt-in because they can write a large amount of live data.
SPEC_STARTUP_BACKFILL_ENABLED=false
# This only takes effect when SPEC_STARTUP_BACKFILL_ENABLED is also true.
SPEC_STARTUP_AUTHORITATIVE_ENABLED=false
SPEC_BACKFILL_MAX_DOCUMENTS=5000

# Notion Configuration
NOTION_ENABLED=false
NOTION_TOKEN=your-notion-integration-token
NOTION_ROOT_PAGE_ID=your-root-page-id
NOTION_SYNC_CRON_HOUR=1
NOTION_SYNC_CRON_MINUTE=0
NOTION_MAX_DEPTH=5
NOTION_MAX_PAGES=500

# Worker Configuration
WORKER_CONCURRENCY=4
LOG_LEVEL=INFO
LOG_FORMAT=console

# Server Configuration
HOST=0.0.0.0
PORT=8080
ENVIRONMENT=development

# Security Configuration
# Required when ENVIRONMENT=production. Store this in a Secret, never a ConfigMap.
# Development may leave it empty to disable API key authentication.
WORKER_API_KEY=

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30.0
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# Sync State Persistence (production mounts this directory from a PVC)
SYNC_STATE_FILE=/var/lib/skald-worker/sync-state.json
