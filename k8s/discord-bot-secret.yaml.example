apiVersion: v1
kind: Secret
metadata:
    name: discord-bot-secrets
    namespace: skald
    labels:
        app: skald
        component: discord-bot
type: Opaque
stringData:
    DISCORD_BOT_TOKEN: 'your_discord_bot_token_here'
    SKALD_API_KEY: 'your_skald_api_key_here'
    SKALD_PROJECT_ID: 'your_skald_project_id_here'
