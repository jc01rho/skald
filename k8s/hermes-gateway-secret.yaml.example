apiVersion: v1
kind: Secret
metadata:
    name: hermes-gateway-secrets
    namespace: skald
    labels:
        app: skald
        component: hermes-gateway
type: Opaque
stringData:
    DISCORD_BOT_TOKEN: 'replace_with_discord_bot_token'
    OPENAI_API_KEY: 'replace_with_openai_compatible_api_key'
    SKALD_API_KEY: 'replace_with_skald_project_api_key'
    SKALD_PROJECT_ID: 'replace_with_skald_project_id'
